# Copie para .env.local (desenvolvimento) — sem estas variáveis o app roda em modo local.
# Os valores de produção ficam em .env.production (todos são públicos por natureza).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
VITE_VAPID_PUBLIC_KEY=sua-chave-publica-vapid
# true somente após configurar o provedor Google no painel do Supabase
VITE_GOOGLE_AUTH=false
